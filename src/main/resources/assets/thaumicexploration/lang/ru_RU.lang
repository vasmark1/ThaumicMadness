----Thaumonomicon Entries----
te.researchPrefix=[TX]
tc.research_category.TAINT=Таинтология
tc.research_category.NECROMANCY=Некромантия
tc.research_category.TX=Эзотерика

--Oblivion Jar
te.name.TRASHJAR=Банка забвения
te.tag.TRASHJAR=Утилизация эссенции
te.text.TRASHJAR.1=Банка забвения позволяет бесследно уничтожать излишки любых видов эссенции. В отличие от пустотных банок, одной банки забвения достаточно для утилизации всех невостребованных аспектов в сети.
te.text.TRASHJAR.2=Банка забвения обладает самым низким приоритетом втягивания, принимая только ту эссенцию, которую некуда девать.

--Soul Brazier
te.name.SOULBRAZIER=Жаровня душ
te.tag.SOULBRAZIER=Очищение рассудка
te.text.SOULBRAZIER.1=Жаровня душ способна безопасно извлекать и удерживать постоянное искажение из разума тауматурга, расходуя эссенцию Mortus и вис из узла ауры.

--Taintacle Ring
te.name.TENTACLERING=Кольцо щупальца
te.tag.TENTACLERING=Порождение порчи
te.text.TENTACLERING.1=При получении урона на твердой земле кольцо призывает маленькое щупальце порчи, атакующее ближайших врагов.

--Discount Rings
te.name.DISCOUNTRINGS=Кольца бережливости
te.tag.DISCOUNTRINGS=Экономия вис
te.text.DISCOUNTRINGS.1=Магические кольца, снижающие затраты вис при использовании жезлов.

--Thaumostatic Stabilizer
te.name.STABILIZERBELT=Таумостатический стабилизатор
te.tag.STABILIZERBELT=Подавление отдачи
te.text.STABILIZERBELT.1=Пояс, полностью сводящий на нет отбрасывание при получении урона. Идеален для полетов на ранце и боя.

--Floating Candles
te.name.FLOATCANDLE=Плавающие свечи
te.tag.FLOATCANDLE=Левитирующий свет
te.text.FLOATCANDLE.1=Магические свечи, парящие в воздухе без опоры и создающие чарующую атмосферу волшебства.

--Flesh Curing
te.name.FLESHCURE=Очищение плоти
te.tag.FLESHCURE=Алхимическое очищение
te.text.FLESHCURE.1=Удаление следов гниения из гнилой плоти с помощью эссенций для получения полезных материалов.

--Brain Curing
te.name.BRAINCURE=Исцеление мозга
te.tag.BRAINCURE=Просветление разума
te.text.BRAINCURE.1=Обращение вспять процесса зомбификации мозга зомби при помощи зелья слабости и эссенций. Исцеленный мозг обретает высокий интеллектуальный потенциал.

--Think Tank
te.name.THINKTANK=Мыслящий резервуар
te.tag.THINKTANK=Автономные исследования
te.text.THINKTANK.1=Мыслящий резервуар использует исцеленный мозг зомби и поглощает книги, непрерывно генерируя фрагменты знаний для тауматурга.
te.text.THINKTANK.2=Устанавливается на книжную полку с пустым пространством 3x3x3 вокруг.

--Chest Sealing
te.name.CHESTSEAL=Связывающая печать сундука
te.tag.CHESTSEAL=Единое хранилище
te.text.CHESTSEAL.1=Связывает сундуки одного цвета печати в единую общую сеть инвентаря.

--Jar Sealing
te.name.JARSEAL=Связывающая печать банки
te.tag.JARSEAL=Общая эссенция
te.text.JARSEAL.1=Связывает банки с эссенцией в единую дистанционную сеть для удобного наполнения и перекачки.

--Everfull Urn
te.name.URN=Неиссякаемая урна
te.tag.URN=Бесконечный источник воды
te.text.URN.1=Создает бесконечный поток чистейшей воды, наполняет тигли и тушит горящих игроков.
te.text.URN.1B=Создает бесконечный поток чистейшей воды, наполняет тигли, аптекари лепестков и тушит горящих игроков.

--Everburn Urn
te.name.BURN=Неугасимая урна
te.tag.BURN=Вечное пламя
te.text.BURN.1=Генерирует лаву при снабжении CentiVis, наполняя ведра и внешние резервуары.

--Crucible of Souls
te.name.CRUCSOULS=Тигель душ
te.tag.CRUCSOULS=Жатва жизней
te.text.CRUCSOULS.1=Устройство, вытягивающее жизненную силу из ближайших существ и преобразующее её в чистую эссенцию.
te.text.CRUCSOULS.2=Тигель нестабилен и может порождать порчу. Не атакует людей и големов.

--Replicator
te.name.REPLICATOR=Таумический репликатор
te.tag.REPLICATOR=Эквивалентный обмен
te.text.REPLICATOR.1=Создает копии строительных блоков, потребляя соответствующую эссенцию.
te.text.REPLICATOR.2=Установите образец на ПКМ и запустите процесс жезлом или редстоун-сигналом.

--Amber Wand Core
te.name.ROD_AMBER=Янтарный стержень
te.tag.ROD_AMBER=Быстрая регенерация
te.text.ROD_AMBER.1=Стержень из янтаря вмещает 10 вис каждого типа и с повышенной скоростью пассивно восполняет все аспекты вис.

--Amber Staff Core
te.name.ROD_AMBER_staff=Янтарный стержень посоха
te.tag.ROD_AMBER_staff=Энергия янтаря
te.text.ROD_AMBER_staff.1=Посох из янтаря вмещает 25 вис каждого типа и пассивно восстанавливает запасы вис.

--Transmutation Staff Core
te.name.ROD_TRANSMUTATION_staff=Стержень посоха трансмутации
te.tag.ROD_TRANSMUTATION_staff=Превращение вис
te.text.ROD_TRANSMUTATION_staff.1=Вмещает 175 вис каждого типа и преобразует излишки одних аспектов в недостающие при заполнении свыше 90%.

--Necromancer's Staff Core
te.name.ROD_NECROMANCER_staff=Некромантический стержень посоха
te.tag.ROD_NECROMANCER_staff=Власть над смертью
te.text.ROD_NECROMANCER_staff.1=Вмещает 200 вис и получает в 4 раза больше вис от убитых монстров, иссушая врагов при ударе в ближнем бою.

--Bread Wand Core
te.name.ROD_BREAD=Багетный стержень
te.tag.ROD_BREAD=Свежая выпечка
te.text.ROD_BREAD.1=Хрустящий французский багет, наделенный магической силой жезла. Приятного аппетита!

--Sojourner's Wand Cap
te.name.CAP_SOJOURNER=Наконечники странника
te.tag.CAP_SOJOURNER=Автономная зарядка
te.text.CAP_SOJOURNER.1=Пассивно вытягивают вис из ближайших узлов ауры, пока жезл находится в руке.

--Mechanist's Wand Cap
te.name.CAP_MECHANIST=Наконечники механика
te.tag.CAP_MECHANIST=Быстрое поглощение
te.text.CAP_MECHANIST.1=Ускоряют осушение узлов ауры с помощью механических приспособлений.

--Wispy Dreamcatcher
te.name.DREAMCATCHER=Ловец снов
te.tag.DREAMCATCHER=Защита от порчи
te.text.DREAMCATCHER.1=Находясь на панели быстрого доступа, с высокой вероятностью блокирует урон от порчи и зараженных тварей.

--Talisman of Nourishment
te.name.TALISMANFOOD=Талисман сытости
te.tag.TALISMANFOOD=Вечный запас
te.text.TALISMANFOOD.1=Поглощает питательную ценность еды из инвентаря и автоматически насыщает владельца при голоде.

--Disarming Enchantment
te.name.ENCHDISARM=Зачарование: Разоружение
te.tag.ENCHDISARM=Обезоруживание
te.text.ENCHDISARM.1=При ударе мечом заставляет противников выронить удерживаемое оружие.

--Binding Enchantment
te.name.ENCHBINDING=Зачарование: Связывание
te.tag.ENCHBINDING=Удержание на месте
te.text.ENCHBINDING.1=Замедляет врагов, не дает эндерменам телепортироваться, а криперам — взрываться.

--Night Vision Enchantment
te.name.ENCHNIGHTVISION=Зачарование: Ночное зрение
te.tag.ENCHNIGHTVISION=Взгляд во тьму
te.text.ENCHNIGHTVISION.1=Наносится на шлемы и обеспечивает постоянное ночное зрение во тьме.

--Boots of the Meteor
te.name.METEORBOOTS=Метеорные сапоги
te.tag.METEORBOOTS=Метеоритный рывок
te.text.METEORBOOTS.1=Совершают стремительный рывок вперед и мощное сокрушительное падение с нанесением урона по площади.

--Boots of the Comet
te.name.COMETBOOTS=Кометные сапоги
te.tag.COMETBOOTS=Ледяная скорость
te.text.COMETBOOTS.1=Даруют невероятную скорость бега и мгновенно замораживают воду под ногами.

--Runic Boots
te.name.RUNICBOOTS=Рунические стихийные сапоги
te.tag.RUNICBOOTS=Защита и скорость
